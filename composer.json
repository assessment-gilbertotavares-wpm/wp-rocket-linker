{
	"name": "assessment-gilbertotavares-wpm/wp-rocket-linker",
	"description": "Track and report above-the-fold link impressions plugin for WordPress.",
	"type": "wordpress-plugin",
	"keywords": [
		"wordpress",
		"tracking",
		"visibility",
		"analytics"
	],
	"homepage": "https://github.com/assessment-gilbertotavares-wpm/wp-rocket-linker",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "WP Media",
			"email": "contact@wp-media.me",
			"homepage": "https://wp-media.me"
		},
		{
			"name": "Gilberto Tavares",
			"email": "gilbertoetavares@gmail.com"
		}
	],
	"require": {
		"php": ">=7.3",
		"berlindb/core": "dev-master"
	},
	"require-dev": {
		"php": "^7.3 || ^8",
		"brain/monkey": "^2.0",
		"filp/whoops": "~2.0",
		"phpcompatibility/phpcompatibility-wp": "^2.0",
		"phpunit/phpunit": "^5.7 || ^7 || ^8",
		"raveren/kint": "~1.0",
		"squizlabs/php_codesniffer": "^3.0",
		"wp-coding-standards/wpcs": "dev-develop",
		"wp-media/phpunit": "^3"
	},
	"autoload": {
		"psr-4": {
			"WP_Rocket_Linker\\": "src/"
		}
	},
	"extra": {
		"branch-alias": {
			"dev-develop": "1.0.0-dev"
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"minimum-stability": "dev",
	"scripts": {
		"test-unit": "vendor/bin/phpunit --testsuite unit --colors=always --configuration \"Tests/Unit/phpunit.xml.dist\"",
		"test-integration": "vendor/bin/phpunit --testsuite integration --colors=always --configuration \"Tests/Integration/phpunit.xml.dist\"",
		"run-tests": [
			"@test-unit",
			"@test-integration"
		],
		"phpcs": "phpcs --basepath=.",
		"phpcs:fix": "phpcbf"
	}
}
